<?xml version="1.0" encoding="UTF-8"?>
<!-- 해당 xml에서 사용할 태그 규칙 지정 dtd mybatis 태그 규칙을 적용하기 위해 mtbatis에서 제공하는 dtd -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.songjae.modenshop.member.manager.repository.ManagerMemberRepository">
	<select id="existsByEmail" parameterType="string" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM `manager_member`
            WHERE `email` = #{email}
        )
    </select>
	
	<select id="selectIdAndPasswordByEmail" parameterType="string" resultType="com.songjae.modenshop.member.manager.domain.ManagerMember">
        SELECT 
        	`id`
        , `password`
        FROM `manager_member`
        WHERE `email` = #{email}
    </select>
    
	<select id="selectNameById" parameterType="long" resultType="String">
        SELECT 
        `name`
        FROM `manager_member`
        WHERE `id` = #{id}
    </select>
    
	<select id="selectPasswordById" parameterType="long" resultType="String">
        SELECT 
        `password`
        FROM `manager_member`
        WHERE `id` = #{id}
    </select>
	
	<update id="updateEmailById" parameterType="com.songjae.modenshop.member.manager.domain.ManagerMember">
		UPDATE `manager_member`
		SET `email` = #{email}
		WHERE `id` = #{id}
	</update>
	
	<update id="updatePasswordById" parameterType="com.songjae.modenshop.member.manager.domain.ManagerMember">
		UPDATE `manager_member`
		SET `password` = #{password}
		WHERE `id` = #{id}
	</update>
	
	<select id="selectShopInfoIdById" parameterType="long" resultType="long">
		SELECT 
        `shopInfoId`
        FROM `manager_member`
        WHERE `id` = #{id}
	</select>
	
	
	
	
	
	
	
	
	
	<select id="selectManagerProfileInfo" parameterType="long" resultType="com.songjae.modenshop.member.manager.dto.ManagerProfileInfoDto">
		SELECT manager_member.name AS `managerName`, shop_info.shopLogImg AS `managerProfileImg`
		FROM `manager_member`
		JOIN `shop_info`
		ON manager_member.shopInfoId = shop_info.id
		WHERE manager_member.id = #{managerMemberId}
	</select>
</mapper>
